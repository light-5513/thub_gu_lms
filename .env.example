APP_NAME=LMS
APP_ENV=development

APP_URL=http://localhost:8000
API_URL=http://localhost:8000

# Monolith mode: path to the built React frontend (auto-detected as
# <repo>/frontend/dist if empty). Set to a custom path to override.
FRONTEND_DIST_DIR=

MONGODB_URI=
MONGODB_DATABASE=lms

SECRET_KEY=
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

REDIS_URL=redis://localhost:6379/0

GITHUB_API_TOKEN=

LEETCODE_API_URL=https://leetcode.com/graphql
CODECHEF_API_URL=https://www.codechef.com/users/
CODEFORCES_API_URL=https://codeforces.com/api
ATCODER_API_URL=https://kenkoooo.com/atcoder/atcoder-api/v3
